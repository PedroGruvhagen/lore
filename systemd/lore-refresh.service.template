[Unit]
Description=Lore refresh

[Service]
Type=oneshot
ExecStart=/bin/bash __SKILL_DIR__/scripts/lore-refresh.sh
Environment=LORE_DIR=__LORE_DIR__
Environment=HOME=__HOME__
Environment=PATH=__PATH__
WorkingDirectory=__HOME__
StandardOutput=append:__LORE_DIR__/.refresh.stdout.log
StandardError=append:__LORE_DIR__/.refresh.stderr.log
