[Unit]
Description=Lore nightly gardener

[Service]
Type=oneshot
ExecStart=/bin/bash __SKILL_DIR__/scripts/lore-gardener.sh
Environment=LORE_DIR=__LORE_DIR__
Environment=HOME=__HOME__
Environment=PATH=__PATH__
WorkingDirectory=__HOME__
StandardOutput=append:__LORE_DIR__/.gardener/systemd.out.log
StandardError=append:__LORE_DIR__/.gardener/systemd.err.log
