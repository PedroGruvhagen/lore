<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>__LABEL_PREFIX__watchdog</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__SKILL_DIR__/scripts/lore-watchdog.sh</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>__PATH__</string>
        <key>HOME</key>
        <string>__HOME__</string>
        <key>LORE_DIR</key>
        <string>__LORE_DIR__</string>
    </dict>

    <key>StartInterval</key>
    <integer>300</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__LORE_DIR__/.watchdog.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>__LORE_DIR__/.watchdog.stderr.log</string>

    <key>WorkingDirectory</key>
    <string>__HOME__</string>

    <key>AbandonProcessGroup</key>
    <true/>
</dict>
</plist>
