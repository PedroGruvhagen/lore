<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>__LABEL_PREFIX__gardener</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__SKILL_DIR__/scripts/lore-gardener.sh</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>__PATH__</string>
        <key>HOME</key>
        <string>__HOME__</string>
        <key>LORE_DIR</key>
        <string>__LORE_DIR__</string>
    </dict>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>__LORE_DIR__/.gardener/launchd.out.log</string>

    <key>StandardErrorPath</key>
    <string>__LORE_DIR__/.gardener/launchd.err.log</string>

    <key>WorkingDirectory</key>
    <string>__HOME__</string>

    <key>AbandonProcessGroup</key>
    <true/>
</dict>
</plist>
